# Worker Dockerfile
FROM golang:1.25-alpine AS builder

WORKDIR /build

ENV GOPROXY=https://goproxy.cn,direct

# 复制 nsp-platform 替换模块
COPY nsp-platform third_party/nsp-platform

# 复制主项目代码
COPY vpc_workflow_demo/ .

# Docker 环境中修改 replace 路径以匹配构建上下文
# 使用绝对路径确保 replace 正确指向本地 nsp-platform
RUN sed -i 's|../nsp-platform|/build/third_party/nsp-platform|g' go.mod && \
    go mod edit -replace github.com/jinleili-zz/nsp-platform=/build/third_party/nsp-platform && \
    go mod tidy

RUN CGO_ENABLED=0 GOOS=linux go build -o worker ./cmd/worker

FROM alpine:latest

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories && \
    apk --no-cache add ca-certificates tzdata

WORKDIR /app

COPY --from=builder /build/worker /app/
COPY --from=builder /build/config /app/config

RUN mkdir -p /app/logs

CMD ["/app/worker"]
